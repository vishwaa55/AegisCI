# AegisCI Configuration Template

# LLM Provider Configuration
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Optional Alternative Providers
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# GitHub API Configuration (Used by Reviewer Agent to open draft PRs)
GITHUB_TOKEN=your_personal_access_token_here
GITHUB_REPOSITORY=owner/repository_name

# AegisCI Backend Configuration
AEGIS_BACKEND_URL=http://localhost:8000
DATABASE_URL=sqlite:///./aegis.db
LOG_LEVEL=INFO
